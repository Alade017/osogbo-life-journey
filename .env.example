# Client-visible Supabase project configuration. Use only a publishable/anon key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Hosted vector map style used by the Osogbo game map.
VITE_OSOGBO_MAP_STYLE_URL=https://tiles.stadiamaps.com/styles/alidade_smooth.json

# Optional browser key. Restrict it to approved domains in the provider dashboard.
# Production sites should use domain-based authentication where available.
# VITE_STADIA_MAPS_API_KEY=

# Optional OSRM-compatible driving route service. The public demo is for development only.
# Configure a production provider with appropriate capacity and terms before release.
# VITE_ROUTING_BASE_URL=https://your-routing-provider.example

# Server/runtime secrets belong in the deployment secret manager, never in VITE_* variables.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret
# CRON_SECRET=server-only-secret
# CRON_SECRET_PREVIOUS=optional-rotation-secret
# DATABASE_URL=restricted-migration-connection-string
