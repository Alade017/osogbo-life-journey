{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Public website: develop",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev:public"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Public website: build",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "build:public"
      ],
      "problemMatcher": []
    },
    {
      "label": "Game: develop",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Game: build",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "build"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Game: check types",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "typecheck"
      ],
      "problemMatcher": "$tsc"
    },
    {
      "label": "Game: test",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "test",
        "--",
        "--maxWorkers=1",
        "--pool=threads"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "type": "docker-build",
      "label": "docker-build",
      "platform": "node",
      "dockerBuild": {
        "dockerfile": "${workspaceFolder}/.output/server/Dockerfile",
        "context": "${workspaceFolder}/.output/server",
        "pull": true
      },
      "node": {
        "package": "${workspaceFolder}/.output/server/package.json"
      }
    },
    {
      "type": "docker-run",
      "label": "docker-run: release",
      "dependsOn": [
        "docker-build"
      ],
      "platform": "node",
      "node": {
        "package": "${workspaceFolder}/.output/server/package.json"
      }
    },
    {
      "type": "docker-run",
      "label": "docker-run: debug",
      "dependsOn": [
        "docker-build"
      ],
      "dockerRun": {
        "env": {
          "DEBUG": "*",
          "NODE_ENV": "development"
        }
      },
      "node": {
        "package": "${workspaceFolder}/.output/server/package.json",
        "enableDebugging": true
      }
    }
  ]
}
